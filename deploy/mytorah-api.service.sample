[Unit]
Description=mytorah meforshim API
After=network.target

[Service]
User=www-data
WorkingDirectory=/path/to/mytorah/api
# meforshim/.env must contain the LLM API keys
ExecStart=/path/to/venv/bin/uvicorn server:app --host 127.0.0.1 --port 8001
Restart=on-failure

[Install]
WantedBy=multi-user.target
